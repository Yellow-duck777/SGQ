@page
@model SGQ.Web.Areas.Identity.Pages.Account.Manage.ChangePasswordModel
@{
    ViewData["Title"] = "Alterar senha";
}

<header class="page-header">
    <div class="page-header-main">
        <h1>Alterar senha</h1>
        <p class="page-header-lead">Informe a senha atual e escolha uma nova.</p>
    </div>
</header>

<div class="account-page">
    <form method="post" class="account-card" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <div class="field-group">
            <label asp-for="Input.OldPassword">Senha atual</label>
            <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" autofocus />
            <span asp-validation-for="Input.OldPassword" class="field-error"></span>
        </div>
        <div class="field-group">
            <label asp-for="Input.NewPassword">Nova senha</label>
            <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" aria-describedby="requisitos-senha" />
            <span asp-validation-for="Input.NewPassword" class="field-error"></span>
            <div id="requisitos-senha" class="account-help">
                A senha precisa ter:
                <ul class="account-list">@foreach (var requisito in Model.RequisitosSenha) { <li>@requisito</li> }</ul>
            </div>
        </div>
        <div class="field-group">
            <label asp-for="Input.ConfirmPassword">Repita a nova senha</label>
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
            <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Salvar nova senha</button>
            <a class="btn btn-outline-secondary" asp-page="./Index">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
