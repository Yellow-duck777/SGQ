@page
@model SGQ.Web.Areas.Identity.Pages.Account.ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Senha redefinida";
}

<div class="account-state-icon" aria-hidden="true">✓</div>
<div class="login-form-heading">
    <p class="eyebrow">Recuperação de acesso</p>
    <h2 id="conta-titulo">Senha redefinida</h2>
    <p>Se os dados informados estavam corretos, a nova senha já vale. Use-a para entrar no sistema.</p>
</div>
<div class="account-actions">
    <a class="btn-account" asp-page="./Login">Ir para o acesso</a>
</div>
