@page
@model SGQ.Web.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Criar nova senha";
}

@if (Model.LinkInvalido)
{
    <div class="account-state-icon" data-tom="alerta" aria-hidden="true">!</div>
    <div class="login-form-heading">
        <p class="eyebrow">Recuperação de acesso</p>
        <h2 id="conta-titulo">Link inválido ou incompleto</h2>
        <p>Não foi possível usar este link de redefinição. Ele pode ter expirado ou ter sido copiado de forma incompleta.</p>
    </div>
    <div class="account-actions">
        <a class="btn-account" asp-page="./ForgotPassword">Pedir um novo link</a>
        <a class="btn-account btn-account-secondary" asp-page="./Login">Voltar para o acesso</a>
    </div>
}
else
{
    <div class="login-form-heading">
        <p class="eyebrow">Recuperação de acesso</p>
        <h2 id="conta-titulo">Criar nova senha</h2>
        <p>Confirme o seu e-mail e escolha uma nova senha.</p>
    </div>
    <form method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <input asp-for="Input.Code" type="hidden" />
        <div class="field-group">
            <label asp-for="Input.Email">E-mail corporativo</label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" autofocus />
            <span asp-validation-for="Input.Email" class="field-error"></span>
        </div>
        <div class="field-group">
            <label asp-for="Input.Password">Nova senha</label>
            <div class="password-field">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" aria-describedby="requisitos-senha" />
                <button type="button" data-password-toggle aria-label="Mostrar senha">Mostrar</button>
            </div>
            <span asp-validation-for="Input.Password" class="field-error"></span>
            <div id="requisitos-senha" class="account-help">
                A senha precisa ter:
                <ul class="account-list">@foreach (var requisito in Model.RequisitosSenha) { <li>@requisito</li> }</ul>
            </div>
        </div>
        <div class="field-group">
            <label asp-for="Input.ConfirmPassword">Repita a nova senha</label>
            <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" aria-required="true" />
            <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
        </div>
        <button type="submit" class="btn-login">Salvar nova senha <span aria-hidden="true">→</span></button>
    </form>
}
