@page
@model SGQ.Web.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar senha";
}

<div class="login-form-heading">
    <p class="eyebrow">Recuperação de acesso</p>
    <h2 id="conta-titulo">Esqueceu a senha?</h2>
    <p>Informe o e-mail da sua conta para pedir a redefinição.</p>
</div>
<form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <div class="field-group">
        <label asp-for="Input.Email">E-mail corporativo</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nome@empresa.com" autofocus />
        <span asp-validation-for="Input.Email" class="field-error"></span>
    </div>
    <button type="submit" class="btn-login">Pedir redefinição <span aria-hidden="true">→</span></button>
</form>
<p class="access-request"><a asp-page="./Login">Voltar para o acesso</a></p>
