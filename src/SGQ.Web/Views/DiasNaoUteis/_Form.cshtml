@model SGQ.Web.Models.DiaNaoUtil
<form method="post" class="card shadow-sm border-0 p-4 form-card"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><input type="hidden" asp-for="Id" /><div class="row g-3"><div class="col-md-4"><label asp-for="Data" class="form-label"></label><input asp-for="Data" class="form-control" /><span asp-validation-for="Data" class="text-danger"></span></div><div class="col-md-2"><label asp-for="Ano" class="form-label"></label><input asp-for="Ano" class="form-control" /><span asp-validation-for="Ano" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Tipo" class="form-label"></label><select asp-for="Tipo" asp-items="Html.GetEnumSelectList<SGQ.Web.Models.TipoDiaNaoUtil>()" class="form-select"></select></div><div class="col-12"><label asp-for="Descricao" class="form-label"></label><input asp-for="Descricao" class="form-control" /><span asp-validation-for="Descricao" class="text-danger"></span></div><div class="col-12 form-check ms-2"><input asp-for="Ativo" class="form-check-input" /><label asp-for="Ativo" class="form-check-label">Ativo para cálculo de prazos</label></div></div><div class="mt-4"><button class="btn btn-primary">Salvar</button><a asp-action="Index" asp-route-ano="@Model.Ano" class="btn btn-outline-secondary">Cancelar</a></div></form>
