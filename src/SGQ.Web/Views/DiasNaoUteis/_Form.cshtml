@model SGQ.Web.Models.DiaNaoUtil
<form method="post" class="cad-form-narrow" novalidate>
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <section class="form-section">
        <header><h2>Data e descrição</h2><p class="help">O ano é preenchido a partir da data e precisa ser o mesmo dela.</p></header>
        <div class="form-grid">
            <div class="span-5">
                <label asp-for="Data" class="form-label required">Data</label>
                <input asp-for="Data" class="form-control" data-cad-data />
                <span asp-validation-for="Data" class="field-error"></span>
            </div>
            <div class="span-3">
                <label asp-for="Ano" class="form-label required">Ano</label>
                <input asp-for="Ano" class="form-control" inputmode="numeric" data-cad-ano />
                <span asp-validation-for="Ano" class="field-error"></span>
            </div>
            <div class="span-4">
                <label asp-for="Tipo" class="form-label required">Tipo</label>
                <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<SGQ.Web.Models.TipoDiaNaoUtil>()" class="form-select"></select>
                <span asp-validation-for="Tipo" class="field-error"></span>
            </div>
            <div>
                <label asp-for="Descricao" class="form-label required">Descrição</label>
                <input asp-for="Descricao" class="form-control" maxlength="200" autocomplete="off" aria-describedby="ajuda-descricao" />
                <div id="ajuda-descricao" class="form-text">Ex.: Confraternização Universal, Recesso de fim de ano.</div>
                <span asp-validation-for="Descricao" class="field-error"></span>
            </div>
        </div>
    </section>
    <section class="form-section">
        <header><h2>Efeito nos prazos</h2></header>
        <div class="cad-check">
            <input asp-for="Ativo" class="form-check-input" />
            <label asp-for="Ativo" class="form-check-label">Descontar esta data no cálculo de prazos<span class="form-text d-block">Desmarque para manter o registro sem que a data seja descontada.</span></label>
        </div>
    </section>
    <div class="form-actions"><button class="btn btn-primary" type="submit">Salvar</button><a asp-action="Index" asp-route-ano="@Model.Ano" class="btn btn-outline-secondary">Cancelar</a></div>
</form>
