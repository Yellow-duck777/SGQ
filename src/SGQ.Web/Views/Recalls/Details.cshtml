@model SGQ.Web.Models.Recall
@{ ViewData["Title"] = Model.Codigo; }
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="page-heading d-flex justify-content-between align-items-center gap-3 mb-4"><div><p class="eyebrow mb-1">Recall / Recolhimento</p><h1>@Model.Codigo</h1><span class="badge text-bg-secondary">@Model.Status</span></div><a class="btn btn-outline-secondary" asp-action="Index">Voltar</a></div>
<div class="card shadow-sm border-0 p-4"><dl class="row mb-0"><dt class="col-sm-3">Origem</dt><dd class="col-sm-9">@Model.Origem</dd><dt class="col-sm-3">Produto / lote</dt><dd class="col-sm-9">@Model.Produto.Nome — @Model.Lote.Numero</dd><dt class="col-sm-3">NC vinculada</dt><dd class="col-sm-9">@(Model.NaoConformidade?.Codigo ?? "Não aplicável")</dd><dt class="col-sm-3">Reclamação vinculada</dt><dd class="col-sm-9">@(Model.ReclamacaoCliente?.Codigo ?? "Não aplicável")</dd><dt class="col-sm-3">Risco</dt><dd class="col-sm-9">@Model.RiscoPotencial</dd><dt class="col-sm-3">Decisão</dt><dd class="col-sm-9">@Model.Decisao — @Model.JustificativaDecisao</dd></dl></div>
@if (Model.Status == SGQ.Web.Models.StatusRecall.EmAvaliacao) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Aprovação técnica</h2><p>Envie a avaliação para aprovação de RT e GQ antes de iniciar o recolhimento.</p><form asp-action="SolicitarAprovacao" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-primary">Solicitar aprovação</button></form></section> }
@if (Model.Status == SGQ.Web.Models.StatusRecall.AguardandoAprovacao) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Aprovação técnica</h2><p>RT: @(Model.AprovadaRt ? "Aprovada" : "Pendente") · GQ: @(Model.AprovadaGq ? "Aprovada" : "Pendente")</p><div class="d-flex gap-2 flex-wrap"><form asp-action="Aprovar" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="perfil" value="RT" /><button class="btn btn-outline-primary">Aprovar como RT</button></form><form asp-action="Aprovar" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="perfil" value="GQ" /><button class="btn btn-outline-primary">Aprovar como GQ</button></form><form asp-action="Reprovar" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="perfil" value="RT" /><button class="btn btn-outline-danger">Reprovar como RT</button></form><form asp-action="Reprovar" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="perfil" value="GQ" /><button class="btn btn-outline-danger">Reprovar como GQ</button></form></div></section> }
@if (Model.Status == SGQ.Web.Models.StatusRecall.AguardandoDecisaoCq) { <section class="card shadow-sm border-warning p-4 mt-4"><h2 class="h5">Divergência técnica — decisão do CQ</h2><p>RT: @(Model.AprovadaRt ? "Aprovado" : "Reprovado") · GQ: @(Model.AprovadaGq ? "Aprovado" : "Reprovado")</p><form asp-action="DecidirDivergencia" method="post"><input type="hidden" name="id" value="@Model.Id" /><textarea name="justificativa" class="form-control" minlength="10" required placeholder="Fundamentação da decisão do CQ"></textarea><button name="favoravel" value="true" class="btn btn-primary mt-3">Decisão favorável</button><button name="favoravel" value="false" class="btn btn-outline-danger mt-3">Retornar para avaliação</button></form></section> }
@if (Model.Status == SGQ.Web.Models.StatusRecall.EmRecolhimento) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Início do recolhimento</h2><form asp-action="RegistrarOperacao" method="post"><input type="hidden" name="id" value="@Model.Id" /><div class="row g-3"><div class="col-md-3 d-flex align-items-end"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="bloqueioRegistrado" value="true" id="bloqueio" /><label class="form-check-label" for="bloqueio">Bloqueio registrado</label></div></div><div class="col-md-5"><label class="form-label">Comunicação aos clientes</label><input name="comunicacaoClientes" class="form-control" required /></div><div class="col-md-2"><label class="form-label">Autoridade sanitária</label><input name="autoridadeSanitaria" class="form-control" required /></div><div class="col-md-2"><label class="form-label">Protocolo</label><input name="protocoloAutoridade" class="form-control" /></div></div><button class="btn btn-primary mt-3">Iniciar retornos</button></form></section> }
@if (Model.Status == SGQ.Web.Models.StatusRecall.AguardandoRetorno) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Retornos de produto</h2><table class="table"><thead><tr><th>Cliente</th><th>Quantidade</th><th>Data</th><th>Embalagem</th></tr></thead><tbody>@foreach (var retorno in Model.Retornos) { <tr><td>@retorno.Cliente</td><td>@retorno.Quantidade</td><td>@retorno.DataRetorno.ToString("dd/MM/yyyy")</td><td>@retorno.CondicaoEmbalagem</td></tr> }</tbody></table><form asp-action="AdicionarRetorno" method="post" class="row g-2"><input type="hidden" name="recallId" value="@Model.Id" /><div class="col-md-3"><input name="cliente" class="form-control" placeholder="Cliente" required /></div><div class="col-md-2"><input name="quantidade" type="number" step="0.01" class="form-control" placeholder="Quantidade" required /></div><div class="col-md-2"><input name="dataRetorno" type="date" class="form-control" required /></div><div class="col-md-3"><input name="condicaoEmbalagem" class="form-control" placeholder="Condição embalagem" required /></div><div class="col-md-2"><button class="btn btn-outline-primary">Registrar retorno</button></div><input type="hidden" name="condicaoLacre" /><input type="hidden" name="avarias" /><input type="hidden" name="documentoTransporte" /></form><form asp-action="AvancarDestinacao" method="post" class="mt-3"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-primary">Avançar para destinação</button></form></section> }
@if (Model.Status == SGQ.Web.Models.StatusRecall.EmAvaliacaoDeDestinacao) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Destinação</h2><form asp-action="RegistrarDestinacao" method="post"><input type="hidden" name="id" value="@Model.Id" /><label class="form-label">Destinação</label><input name="destinacao" class="form-control" placeholder="Ex.: descarte, retrabalho" required /><label class="form-label mt-3">Evidência</label><input name="evidenciaDestinacao" class="form-control" required /><button class="btn btn-primary mt-3">Registrar destinação</button></form></section> }
@if (Model.Status == SGQ.Web.Models.StatusRecall.AguardandoEncerramento) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Encerramento</h2><p><strong>Destinação:</strong> @Model.Destinacao</p><form asp-action="Encerrar" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-primary">Encerrar Recall</button></form></section> }
@if (Model.Status == SGQ.Web.Models.StatusRecall.Encerrado) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Reabertura</h2><p class="text-muted">Use apenas quando uma informação relevante exigir nova avaliação e aprovações técnicas.</p><form asp-action="Reabrir" method="post"><input type="hidden" name="Id" value="@Model.Id" /><div class="row g-3"><div class="col-md-4"><label class="form-label" for="Motivo">Motivo</label><input class="form-control" id="Motivo" name="Motivo" minlength="10" maxlength="500" required /></div><div class="col-md-8"><label class="form-label" for="Justificativa">Justificativa</label><textarea class="form-control" id="Justificativa" name="Justificativa" rows="2" minlength="10" maxlength="2000" required></textarea></div></div><button class="btn btn-outline-danger mt-3">Reabrir Recall</button></form></section> }
@if (Model.ReabertaEm.HasValue) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Última reabertura</h2><p class="mb-1"><strong>Motivo:</strong> @Model.MotivoReabertura</p><p class="mb-1"><strong>Justificativa:</strong> @Model.JustificativaReabertura</p><p class="mb-0 text-muted">Por @Model.UsuarioReabertura em @Model.ReabertaEm.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm"). Status anterior: @Model.StatusAnteriorReabertura.</p></section> }
@if (Model.DecididaPeloCqEm.HasValue) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Decisão do CQ</h2><p class="mb-1">@Model.DecisaoCq — @Model.JustificativaDecisaoCq</p><p class="mb-0 text-muted">Por @Model.UsuarioDecisaoCq em @Model.DecididaPeloCqEm.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p></section> }
<partial name="_Anexos" model='("Recalls", Model.Id)' />
<partial name="_ProrrogacaoPrazo" model='("Prorrogar", Model.Id, Model.DataAlvo)' />
