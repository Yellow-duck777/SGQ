@model SGQ.Web.ViewModels.RecallCreateViewModel
@{ ViewData["Title"] = "Novo Recall"; }
<div class="page-heading mb-4"><p class="eyebrow mb-1">Processos de qualidade</p><h1>Novo Recall / Recolhimento</h1><p class="text-muted mb-0">Registre a avaliação e a decisão técnica inicial.</p></div>
<form method="post" class="card shadow-sm border-0 p-4 form-card"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3">
<div class="col-md-4"><label asp-for="DataAbertura" class="form-label">Data de abertura</label><input asp-for="DataAbertura" class="form-control" /><span asp-validation-for="DataAbertura" class="text-danger"></span></div>
<div class="col-md-8"><label asp-for="Origem" class="form-label"></label><select asp-for="Origem" asp-items="Html.GetEnumSelectList<SGQ.Web.Models.OrigemRecall>()" class="form-select"></select></div>
<div class="col-md-6"><label asp-for="NaoConformidadeId" class="form-label">Não Conformidade vinculada</label><select asp-for="NaoConformidadeId" asp-items="ViewBag.NaoConformidades" class="form-select"><option value="">Não aplicável</option></select></div>
<div class="col-md-6"><label asp-for="ReclamacaoClienteId" class="form-label">Reclamação vinculada</label><select asp-for="ReclamacaoClienteId" asp-items="ViewBag.Reclamacoes" class="form-select"><option value="">Não aplicável</option></select></div>
<div class="col-md-6"><label asp-for="ProdutoId" class="form-label">Produto</label><select asp-for="ProdutoId" asp-items="ViewBag.Produtos" class="form-select"><option value="">Selecione</option></select><span asp-validation-for="ProdutoId" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="LoteId" class="form-label">Lote</label><select asp-for="LoteId" asp-items="ViewBag.Lotes" class="form-select"><option value="">Selecione</option></select><span asp-validation-for="LoteId" class="text-danger"></span></div>
<div class="col-md-3"><label asp-for="DataFabricacao" class="form-label"></label><input asp-for="DataFabricacao" class="form-control" /></div><div class="col-md-3"><label asp-for="DataValidade" class="form-label"></label><input asp-for="DataValidade" class="form-control" /></div>
<div class="col-md-2"><label asp-for="QuantidadeProduzida" class="form-label">Qtd. produzida</label><input asp-for="QuantidadeProduzida" class="form-control" /></div><div class="col-md-2"><label asp-for="QuantidadeEstoque" class="form-label">Qtd. estoque</label><input asp-for="QuantidadeEstoque" class="form-control" /></div><div class="col-md-2"><label asp-for="QuantidadeDistribuida" class="form-label">Qtd. distribuída</label><input asp-for="QuantidadeDistribuida" class="form-control" /></div>
<div class="col-12"><label asp-for="ClientesEnvolvidos" class="form-label">Clientes envolvidos</label><textarea asp-for="ClientesEnvolvidos" rows="2" class="form-control"></textarea><span asp-validation-for="ClientesEnvolvidos" class="text-danger"></span></div>
<div class="col-12"><label asp-for="NaturezaOcorrencia" class="form-label">Natureza da ocorrência</label><textarea asp-for="NaturezaOcorrencia" rows="3" class="form-control"></textarea><span asp-validation-for="NaturezaOcorrencia" class="text-danger"></span></div>
<div class="col-12"><label asp-for="RiscoPotencial" class="form-label">Risco potencial</label><textarea asp-for="RiscoPotencial" rows="3" class="form-control"></textarea><span asp-validation-for="RiscoPotencial" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Decisao" class="form-label">Decisão</label><select asp-for="Decisao" asp-items="Html.GetEnumSelectList<SGQ.Web.Models.DecisaoRecall>()" class="form-select"></select></div><div class="col-md-8"><label asp-for="JustificativaDecisao" class="form-label">Justificativa da decisão</label><textarea asp-for="JustificativaDecisao" rows="2" class="form-control"></textarea><span asp-validation-for="JustificativaDecisao" class="text-danger"></span></div>
</div><div class="d-flex gap-2 mt-4"><button class="btn btn-primary" type="submit">Registrar avaliação</button><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
