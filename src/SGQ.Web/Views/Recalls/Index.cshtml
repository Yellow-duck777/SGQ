@using SGQ.Web.Models
@using SGQ.Web.Presentation
@model IEnumerable<Recall>
@{
    ViewData["Title"] = "Recalls";
    var contagem = ViewBag.ContagemPorSituacao as Dictionary<StatusRecall, int> ?? new Dictionary<StatusRecall, int>();
    var statusAtual = Context.Request.Query["status"].ToString();
    var busca = Context.Request.Query["busca"].ToString();
    var temFiltroAvancado = new[] { "decisao", "produtoId", "loteId", "responsavel", "inicio", "fim" }.Any(chave => !string.IsNullOrWhiteSpace(Context.Request.Query[chave]));
    var temFiltro = temFiltroAvancado || !string.IsNullOrWhiteSpace(statusAtual) || !string.IsNullOrWhiteSpace(busca);
    var totalGeral = contagem.Values.Sum();
    var atalhos = new (StatusRecall Situacao, string Nome)[]
    {
        (StatusRecall.EmAvaliacao, "Em avaliação"), (StatusRecall.AguardandoAprovacao, "Aguardando aprovação"),
        (StatusRecall.AguardandoDecisaoCq, "Aguardando decisão do CQ"), (StatusRecall.EmRecolhimento, "Em recolhimento"),
        (StatusRecall.AguardandoRetorno, "Aguardando retorno"), (StatusRecall.EmAvaliacaoDeDestinacao, "Em destinação"),
        (StatusRecall.AguardandoEncerramento, "Aguardando encerramento"), (StatusRecall.Encerrado, "Encerrados")
    };
}
@section Styles { <link rel="stylesheet" href="~/css/modulos/recalls.css" asp-append-version="true" /> }

<header class="page-header">
    <div class="page-header-main">
        <p class="eyebrow">Processos de qualidade</p>
        <h1>Recall e recolhimento</h1>
        <p class="page-header-lead">Avalie o risco, decida pelo recolhimento e acompanhe cada etapa até o encerramento.</p>
    </div>
    <div class="page-header-actions"><a class="btn btn-primary" asp-action="Create">Novo recall</a></div>
</header>

<nav class="chip-row rec-atalhos" aria-label="Atalhos por situação">
    <a class="chip @(statusAtual == "" ? "is-active" : "")" asp-action="Index" aria-current="@(statusAtual == "" ? "page" : null)">Todos <span class="chip-count">@totalGeral</span></a>
    @foreach (var (situacao, nome) in atalhos)
    {
        var ativo = statusAtual == situacao.ToString();
        <a class="chip @(ativo ? "is-active" : "")" asp-action="Index" asp-route-status="@situacao" aria-current="@(ativo ? "page" : null)">@nome <span class="chip-count">@(contagem.TryGetValue(situacao, out var total) ? total : 0)</span></a>
    }
</nav>

<form method="get" class="panel rec-filtros" role="search">
    @if (!string.IsNullOrWhiteSpace(statusAtual)) { <input type="hidden" name="status" value="@statusAtual" /> }
    <div class="filter-bar">
        <div class="filter-search"><label class="form-label" for="busca">Buscar recall</label><input class="form-control" id="busca" name="busca" type="search" value="@busca" placeholder="Código, produto ou lote" /></div>
        <div class="filter-actions"><button class="btn btn-primary" type="submit">Buscar</button>@if (temFiltro) { <a class="btn btn-outline-secondary" asp-action="Index">Limpar filtros</a> }</div>
    </div>
    <details class="rec-mais-filtros" open="@(temFiltroAvancado ? "open" : null)">
        <summary>Mais filtros</summary>
        <div class="filter-bar rec-filtros-avancados">
            <div><label class="form-label" for="decisao">Decisão</label><select class="form-select" id="decisao" name="decisao" asp-items="Html.GetEnumSelectList<DecisaoRecall>()"><option value="">Todas</option></select></div>
            <div><label class="form-label" for="produtoId">Produto</label><select class="form-select" id="produtoId" name="produtoId" asp-items="ViewBag.Produtos"><option value="">Todos</option></select></div>
            <div><label class="form-label" for="loteId">Lote</label><select class="form-select" id="loteId" name="loteId" asp-items="ViewBag.Lotes"><option value="">Todos</option></select></div>
            <div><label class="form-label" for="responsavel">Aberto por</label><input class="form-control" id="responsavel" name="responsavel" value="@Context.Request.Query["responsavel"]" placeholder="Nome do usuário" /></div>
            <div><label class="form-label" for="inicio">Aberto de</label><input class="form-control" id="inicio" name="inicio" type="date" value="@Context.Request.Query["inicio"]" /></div>
            <div><label class="form-label" for="fim">Aberto até</label><input class="form-control" id="fim" name="fim" type="date" value="@Context.Request.Query["fim"]" /></div>
        </div>
    </details>
</form>

@if (!Model.Any())
{
    <div class="panel empty-state">
        <span aria-hidden="true">R</span>
        @if (temFiltro)
        {
            <h3>Nenhum recall encontrado</h3>
            <p>Nenhum registro corresponde aos filtros aplicados. Ajuste a busca ou limpe os filtros.</p>
            <a class="btn btn-outline-primary" asp-action="Index">Limpar filtros</a>
        }
        else
        {
            <h3>Nenhum recall registrado</h3>
            <p>Quando houver risco de recolhimento de um produto, registre a avaliação aqui.</p>
            <a class="btn btn-primary" asp-action="Create">Novo recall</a>
        }
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table-modern table-cards">
            <caption class="visually-hidden">Lista de recalls</caption>
            <thead><tr><th scope="col">Código</th><th scope="col">Produto e lote</th><th scope="col">Decisão</th><th scope="col">Situação</th><th scope="col">Prazo</th><th scope="col">Abertura</th><th scope="col"><span class="visually-hidden">Ações</span></th></tr></thead>
            <tbody>
            @foreach (var recall in Model)
            {
                <tr>
                    <td class="col-code" data-label="Código"><a class="process-code" asp-action="Details" asp-route-id="@recall.Id">@recall.Codigo</a></td>
                    <td data-label="Produto e lote"><span class="rec-produto">@recall.Produto.Nome<span class="cell-sub">Lote @recall.Lote.Numero</span></span></td>
                    <td data-label="Decisão">@recall.Decisao.Rotulo()</td>
                    <td data-label="Situação">@Html.StatusBadge(recall.Status)</td>
                    <td data-label="Prazo">@Html.PrazoChipHtml(recall.DataAlvo, recall.Status == StatusRecall.Encerrado)</td>
                    <td data-label="Abertura">@recall.DataAbertura.ToString("dd/MM/yyyy")</td>
                    <td class="col-actions"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@recall.Id" aria-label="Abrir @recall.Codigo">Abrir</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
