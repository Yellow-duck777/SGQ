@model IEnumerable<SGQ.Domain.Entities.Produto>
@{
    ViewData["Title"] = "Produtos";
    var produtos = Model.ToList();
}
@section Styles { <link rel="stylesheet" href="~/css/modulos/cadastros.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/modulos/cadastros.js" asp-append-version="true"></script> }

<header class="page-header">
    <div class="page-header-main">
        <p class="eyebrow mb-1">Cadastros básicos</p>
        <h1>Produtos</h1>
        <p class="page-header-lead">Produtos usados nas reclamações, não conformidades e recalls. Cada produto reúne os seus lotes.</p>
    </div>
    <div class="page-header-actions"><a class="btn btn-primary" asp-action="Create">Novo produto</a></div>
</header>

@if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }

@if (produtos.Count == 0)
{
    <div class="panel empty-state">
        <span aria-hidden="true">+</span>
        <h3>Nenhum produto cadastrado</h3>
        <p>Cadastre o primeiro produto e, depois, os seus lotes.</p>
        <a class="btn btn-primary" asp-action="Create">Novo produto</a>
    </div>
}
else
{
    <div class="cad-toolbar">
        <div class="cad-search">
            <label class="form-label" for="busca">Buscar produto</label>
            <input id="busca" type="search" class="form-control" placeholder="Nome do produto ou número do lote" autocomplete="off" data-cad-search="#lista" />
        </div>
        <span class="cad-count" aria-live="polite" data-cad-count="produto(s)">@produtos.Count produto(s)</span>
    </div>
    <div class="table-wrap" id="lista">
        <table class="table-modern table-cards">
            <thead><tr><th scope="col">Produto</th><th scope="col">Lotes</th><th scope="col"><span class="visually-hidden">Ações</span></th></tr></thead>
            <tbody>
                @foreach (var produto in produtos)
                {
                    <tr data-busca="@produto.Nome @string.Join(' ', produto.Lotes.Select(l => l.Numero))">
                        <td data-label="Produto" class="cad-nome">@produto.Nome</td>
                        <td data-label="Lotes">
                            @if (produto.Lotes.Count == 0)
                            {
                                <span class="text-muted">Nenhum lote cadastrado</span>
                            }
                            else
                            {
                                <ul class="cad-lotes-list" aria-label="Lotes de @produto.Nome">
                                    @foreach (var lote in produto.Lotes.OrderBy(l => l.Numero)) { <li>@lote.Numero</li> }
                                </ul>
                            }
                        </td>
                        <td class="col-actions"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@produto.Id" aria-label="Editar @produto.Nome">Editar</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="panel empty-state cad-empty-filter" data-cad-empty hidden>Nenhum produto corresponde à busca.</p>
}
