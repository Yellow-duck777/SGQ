@model IEnumerable<SGQ.Web.Models.Produto>
@{ ViewData["Title"] = "Produtos"; }
<div class="page-heading d-flex justify-content-between align-items-center gap-3 mb-4"><div><p class="eyebrow mb-1">Cadastros básicos</p><h1>Produtos</h1><p class="text-muted mb-0">Cadastre os produtos e acompanhe seus lotes.</p></div><a class="btn btn-primary" asp-action="Create">Novo produto</a></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success" role="alert">@success</div> }
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Produto</th><th>Lotes cadastrados</th><th class="text-end">Ações</th></tr></thead><tbody>
@foreach (var produto in Model) { <tr><td>@produto.Nome</td><td>@produto.Lotes.Count</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@produto.Id">Editar</a></td></tr> }
@if (!Model.Any()) { <tr><td colspan="3" class="text-center text-muted py-4">Nenhum produto cadastrado.</td></tr> }
</tbody></table></div></div>
