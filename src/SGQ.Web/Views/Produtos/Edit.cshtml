@model SGQ.Domain.Entities.Produto
@{ ViewData["Title"] = "Editar produto"; }
@section Styles { <link rel="stylesheet" href="~/css/modulos/cadastros.css" asp-append-version="true" /> }
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

<header class="page-header">
    <div class="page-header-main">
        <p class="eyebrow mb-1">Cadastros básicos</p>
        <h1>Editar produto</h1>
        <p class="page-header-lead">Os campos marcados com * são obrigatórios. Os lotes são cadastrados na tela de Lotes.</p>
    </div>
</header>

<form method="post" class="cad-form-narrow" novalidate>
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <section class="form-section">
        <header><h2>Dados do produto</h2><p class="help">O nome aparece na escolha do produto em todos os processos.</p></header>
        <div class="form-grid">
            <div>
                <label asp-for="Nome" class="form-label required">Nome do produto</label>
                <input asp-for="Nome" class="form-control" maxlength="150" autofocus autocomplete="off" />
                <span asp-validation-for="Nome" class="field-error"></span>
            </div>
        </div>
    </section>
    <div class="form-actions"><button class="btn btn-primary" type="submit">Salvar</button><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a></div>
</form>
