@model SGQ.Web.Models.Produto
@{ ViewData["Title"] = "Novo produto"; }
<div class="page-heading mb-4"><p class="eyebrow mb-1">Cadastros básicos</p><h1>Novo produto</h1></div>
<form method="post" class="card shadow-sm border-0 p-4 form-card"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-4"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control" autofocus /><span asp-validation-for="Nome" class="text-danger"></span></div><div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Salvar produto</button><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
