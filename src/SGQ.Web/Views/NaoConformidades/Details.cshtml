@model SGQ.Web.Models.NaoConformidade
@{ ViewData["Title"] = Model.Codigo; }
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> } @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="page-heading d-flex justify-content-between align-items-center gap-3 mb-4"><div><p class="eyebrow mb-1">Não Conformidade</p><h1>@Model.Codigo</h1><span class="badge text-bg-secondary">@Model.Status</span></div><a class="btn btn-outline-secondary" asp-action="Index">Voltar</a></div>
<div class="card shadow-sm border-0 p-4"><dl class="row mb-0"><dt class="col-sm-3">Origem</dt><dd class="col-sm-9">@Model.Origem</dd><dt class="col-sm-3">Produto</dt><dd class="col-sm-9">@(Model.Produto?.Nome ?? "Não informado")</dd><dt class="col-sm-3">Área</dt><dd class="col-sm-9">@Model.Area</dd><dt class="col-sm-3">Descrição</dt><dd class="col-sm-9">@Model.Descricao</dd><dt class="col-sm-3">NC vinculada</dt><dd class="col-sm-9">@(Model.ReclamacaoCliente?.Codigo ?? "Não aplicável")</dd></dl></div>
@if (Model.Status == SGQ.Web.Models.StatusNaoConformidade.EmInvestigacao) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Investigação</h2><form asp-action="RegistrarInvestigacao" method="post"><input type="hidden" name="id" value="@Model.Id" /><div class="row g-3"><div class="col-12"><label class="form-label">Contenção</label><textarea name="contencao" class="form-control" rows="2" required>@Model.Contencao</textarea></div><div class="col-12"><label class="form-label">Investigação</label><textarea name="investigacao" class="form-control" rows="3" required>@Model.Investigacao</textarea></div><div class="col-md-6"><label class="form-label">Causa provável</label><input name="causaProvavel" value="@Model.CausaProvavel" class="form-control" required /></div><div class="col-md-6"><label class="form-label">Causa raiz</label><input name="causaRaiz" value="@Model.CausaRaiz" class="form-control" required /></div><div class="col-12"><label class="form-label">Método de análise</label><input name="metodoAnalise" value="@Model.MetodoAnalise" class="form-control" placeholder="Ex.: 5 Porquês" required /></div></div><button class="btn btn-primary mt-3">Salvar investigação</button></form></section> }
@if (Model.Status == SGQ.Web.Models.StatusNaoConformidade.EmTratamento) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Plano de ação</h2><div class="table-responsive"><table class="table"><thead><tr><th>Ação</th><th>Responsável</th><th>Prazo</th><th>Situação</th><th></th></tr></thead><tbody>@foreach (var acao in Model.Acoes) { <tr><td>@acao.Descricao</td><td>@acao.Responsavel</td><td>@acao.Prazo.ToString("dd/MM/yyyy")</td><td>@(acao.DataConclusao.HasValue ? "Concluída" : "Pendente")</td><td>@if (!acao.DataConclusao.HasValue) { <form asp-action="ConcluirAcao" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="acaoId" value="@acao.Id" /><input name="evidencia" class="form-control form-control-sm d-inline-block w-auto" placeholder="Evidência" /><button class="btn btn-sm btn-outline-primary mt-1">Concluir</button></form> }</td></tr> }</tbody></table></div><form asp-action="AdicionarAcao" method="post" class="row g-2 border-top pt-3"><input type="hidden" name="NaoConformidadeId" value="@Model.Id" /><div class="col-md-5"><input name="Descricao" class="form-control" placeholder="Descrição da ação" required /></div><div class="col-md-3"><input name="Responsavel" class="form-control" placeholder="Responsável" required /></div><div class="col-md-2"><input name="Prazo" type="date" class="form-control" required /></div><div class="col-md-2"><button class="btn btn-outline-primary">Adicionar ação</button></div><input type="hidden" name="Obrigatoria" value="true" /></form><form asp-action="AvaliarEficacia" method="post" class="mt-4"><input type="hidden" name="id" value="@Model.Id" /><p class="mb-2"><strong>Avaliação de eficácia</strong></p><button name="eficaz" value="true" class="btn btn-primary">Eficaz — enviar para aprovação</button><button name="eficaz" value="false" class="btn btn-outline-danger">Ineficaz — retornar à investigação</button></form></section> }
@if (Model.Status == SGQ.Web.Models.StatusNaoConformidade.AguardandoAprovacao) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Aprovação técnica</h2><p>RT: @(Model.AprovadaRt ? "Aprovada" : "Pendente") · GQ: @(Model.AprovadaGq ? "Aprovada" : "Pendente")</p><div class="d-flex gap-2"><form asp-action="Aprovar" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="perfil" value="RT" /><button class="btn btn-outline-primary">Aprovar como RT</button></form><form asp-action="Aprovar" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="perfil" value="GQ" /><button class="btn btn-outline-primary">Aprovar como GQ</button></form><form asp-action="Reprovar" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-outline-danger">Reprovar</button></form>@if (Model.AprovadaRt && Model.AprovadaGq) { <form asp-action="Encerrar" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-primary">Encerrar NC</button></form> }</div></section> }
@if (Model.Status == SGQ.Web.Models.StatusNaoConformidade.Encerrada) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Reabertura</h2><p class="text-muted">A reabertura retorna a NC para investigação e exige uma nova rodada de aprovações.</p><form asp-action="Reabrir" method="post"><input type="hidden" name="Id" value="@Model.Id" /><label class="form-label" for="Justificativa">Justificativa</label><textarea class="form-control" id="Justificativa" name="Justificativa" rows="3" minlength="10" maxlength="2000" required></textarea><button class="btn btn-outline-danger mt-3">Reabrir NC</button></form></section> }
@if (Model.ReabertaEm.HasValue) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Última reabertura</h2><p class="mb-1">@Model.JustificativaReabertura</p><p class="mb-0 text-muted">Por @Model.UsuarioReabertura em @Model.ReabertaEm.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm"). Status anterior: @Model.StatusAnteriorReabertura.</p></section> }
@if (Model.Status == SGQ.Web.Models.StatusNaoConformidade.EmInvestigacao) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Laboratório externo</h2><form asp-action="SolicitarLaboratorio" method="post" class="row g-2"><input type="hidden" name="Id" value="@Model.Id" /><div class="col-md-6"><input name="Laboratorio" class="form-control" placeholder="Laboratório responsável" required /></div><div class="col-md-4"><input name="DataEnvioAmostra" type="date" class="form-control" required /></div><div class="col-md-2"><button class="btn btn-outline-primary">Solicitar</button></div></form></section> }
@if (Model.Status == SGQ.Web.Models.StatusNaoConformidade.AguardandoLaboratorioExterno) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Resultado do laboratório</h2><p>Envie o laudo como anexo crítico e depois registre o resultado.</p><form asp-action="RegistrarResultadoLaboratorio" method="post" class="row g-2"><input type="hidden" name="Id" value="@Model.Id" /><div class="col-md-3"><input name="DataRecebimento" type="date" class="form-control" required /></div><div class="col-md-4"><input name="IdentificacaoLaudo" class="form-control" placeholder="Identificação do laudo" required /></div><div class="col-md-5"><input name="Resultado" class="form-control" placeholder="Resultado" required /></div><div class="col-12"><button class="btn btn-primary">Registrar resultado</button></div></form></section> }
<partial name="_Anexos" model='("NaoConformidades", Model.Id)' />
