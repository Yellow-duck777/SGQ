@model SGQ.Web.ViewModels.DashboardViewModel
@using System.Globalization
@using SGQ.Web.Security
@{
    ViewData["Title"] = "Visão geral";
    var hoje = CultureInfo.GetCultureInfo("pt-BR").TextInfo.ToTitleCase(DateTime.Today.ToString("dddd, d 'de' MMMM", CultureInfo.GetCultureInfo("pt-BR")));
    var admin = User.IsInRole(Roles.Administrador);
    var gq = User.IsInRole(Roles.GarantiaQualidade);
    var operacional = admin || gq || User.IsInRole(Roles.ResponsavelTecnico) || User.IsInRole(Roles.ControleQualidade);
    var somenteAuditor = !operacional;

    var orientacao = admin ? "Você vê todas as pendências do sistema."
        : somenteAuditor ? "Como Auditor, você acompanha todos os processos em modo de consulta."
        : "Estas são as pendências que dependem do seu perfil.";

    string Plural(int n, string singular, string plural) => n == 1 ? singular : plural;
}

<header class="dash-hero">
    <div>
        <p class="eyebrow">@hoje</p>
        <h1>Olá, <span>@Model.NomeUsuario</span></h1>
        <p class="dash-roles">
            @if (Model.Perfis.Count > 0) { foreach (var perfil in Model.Perfis) { <span class="status-badge" data-tom="neutro">@perfil</span> } }
            <span>@orientacao</span>
        </p>
    </div>
    @if (operacional)
    {
        <div class="dash-actions" aria-label="Atalhos">
            <a class="btn btn-primary" asp-controller="Reclamacoes" asp-action="Create">Nova reclamação</a>
            @if (admin || gq) { <a class="btn btn-outline-primary" asp-controller="NaoConformidades" asp-action="Create">Nova não conformidade</a> }
            <a class="btn btn-outline-primary" asp-controller="Recalls" asp-action="Create">Novo recall</a>
        </div>
    }
</header>

<section class="panel attention-panel dash-section" aria-labelledby="atencao-titulo">
    <div class="panel-heading">
        <div>
            <p class="eyebrow">Para agora</p>
            <h2 id="atencao-titulo">Precisa da sua atenção</h2>
        </div>
        @if (Model.Atencao.Count > 0) { <span class="text-muted small">@Model.Atencao.Count @Plural(Model.Atencao.Count, "assunto", "assuntos")</span> }
    </div>
    @if (Model.Atencao.Count == 0)
    {
        <div class="attention-clear">
            <span class="attention-clear-icon" aria-hidden="true">✓</span>
            <div>
                <h3>Nada pendente para você agora</h3>
                <p>Não há processos esperando a sua ação nem prazos vencidos. Acompanhe o andamento geral logo abaixo.</p>
            </div>
        </div>
    }
    else
    {
        <ul class="attention-list">
            @foreach (var item in Model.Atencao)
            {
                <li class="attention-item" data-critico="@(item.Critico ? "true" : "false")">
                    <span class="attention-sigla" aria-hidden="true">@item.Sigla</span>
                    <div class="attention-text">
                        <a asp-controller="@item.Controller" asp-action="Index" asp-route-status="@item.Status">@item.Titulo</a>
                        <p>@item.Descricao</p>
                    </div>
                    <span class="attention-count" aria-label="@item.Contagem @Plural(item.Contagem, "processo", "processos")">@item.Contagem</span>
                    @if (item.MenorPrazo is not null) { @Html.PrazoChipHtml(item.MenorPrazo) } else { <span class="status-badge" data-tom="neutro">Sem prazo</span> }
                    <a class="btn btn-outline-primary" asp-controller="@item.Controller" asp-action="Index" asp-route-status="@item.Status">Abrir lista<span class="visually-hidden">: @item.Titulo</span></a>
                </li>
            }
        </ul>
    }
</section>

<section class="dash-section" aria-labelledby="resumo-titulo">
    <h2 class="dash-section-title" id="resumo-titulo">Processos em aberto</h2>
    <div class="summary-grid">
        @{
            var cartoes = new[]
            {
                (Sigla: "RC", Nome: "Reclamações", Resumo: Model.ResumoReclamacoes, Controller: "Reclamacoes", Legenda: "em aberto"),
                (Sigla: "NC", Nome: "Não conformidades", Resumo: Model.ResumoNaoConformidades, Controller: "NaoConformidades", Legenda: "em aberto"),
                (Sigla: "RE", Nome: "Recalls", Resumo: Model.ResumoRecalls, Controller: "Recalls", Legenda: "ativos")
            };
        }
        @foreach (var cartao in cartoes)
        {
            <article class="summary-card">
                <div class="summary-card-head"><span class="attention-sigla" aria-hidden="true">@cartao.Sigla</span><h3>@cartao.Nome</h3></div>
                <p class="summary-number"><strong>@cartao.Resumo.Abertos</strong><span>@cartao.Legenda</span></p>
                <div class="summary-flags">
                    @if (cartao.Resumo.Vencidos > 0) { <span class="status-badge" data-tom="perigo">@cartao.Resumo.Vencidos @Plural(cartao.Resumo.Vencidos, "vencido", "vencidos")</span> }
                    else { <span class="status-badge" data-tom="sucesso">Nenhum vencido</span> }
                    @if (cartao.Resumo.VencendoEmBreve > 0) { <span class="status-badge" data-tom="alerta">@cartao.Resumo.VencendoEmBreve @Plural(cartao.Resumo.VencendoEmBreve, "vence", "vencem") em até 2 dias úteis</span> }
                </div>
                <a asp-controller="@cartao.Controller" asp-action="Index">Ver @cartao.Nome.ToLowerInvariant() →</a>
            </article>
        }
    </div>
</section>

<section class="panel dash-section" aria-labelledby="recentes-titulo">
    <div class="panel-heading">
        <div><p class="eyebrow">Movimentação</p><h2 id="recentes-titulo">Últimos processos abertos</h2></div>
    </div>
    @if (Model.Movimentos.Count == 0)
    {
        <div class="empty-state">
            <span aria-hidden="true">–</span>
            <h3>Nenhum processo registrado ainda</h3>
            <p>Quando uma reclamação, não conformidade ou recall for aberto, ele aparecerá aqui.</p>
            @if (operacional) { <a class="btn btn-primary" asp-controller="Reclamacoes" asp-action="Create">Registrar a primeira reclamação</a> }
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table-modern table-cards">
                <thead><tr><th scope="col">Processo</th><th scope="col">Assunto</th><th scope="col">Situação</th><th scope="col">Prazo</th><th scope="col">Abertura</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Movimentos)
                {
                    var destino = Url.Action("Details", item.Controller, new { id = item.Id });
                    <tr data-href="@destino">
                        <td data-label="Processo" class="col-code"><a asp-controller="@item.Controller" asp-action="Details" asp-route-id="@item.Id">@item.Codigo</a></td>
                        <td data-label="Assunto"><span class="movement-title">@item.Titulo</span><span class="cell-sub">@item.Subtitulo</span></td>
                        <td data-label="Situação">@Html.StatusBadge(item.Status)</td>
                        <td data-label="Prazo">@Html.PrazoChipHtml(item.DataAlvo, item.Encerrado)</td>
                        <td data-label="Abertura">@item.CriadaEm.ToLocalTime().ToString("dd/MM/yyyy")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<p class="dash-foot">
    Cadastros: <a asp-controller="Clientes" asp-action="Index">@Model.ClientesAtivos @Plural(Model.ClientesAtivos, "cliente", "clientes")</a> ·
    <a asp-controller="Produtos" asp-action="Index">@Model.ProdutosCadastrados @Plural(Model.ProdutosCadastrados, "produto", "produtos")</a> ·
    <a asp-controller="Lotes" asp-action="Index">@Model.LotesCadastrados @Plural(Model.LotesCadastrados, "lote", "lotes")</a>
</p>
