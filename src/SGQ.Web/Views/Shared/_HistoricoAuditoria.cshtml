@model IEnumerable<SGQ.Web.Models.HistoricoAuditoria>
<section class="panel mt-4" aria-labelledby="titulo-historico">
    <header class="panel-heading">
        <div>
            <p class="eyebrow mb-1">Rastreabilidade</p>
            <h2 id="titulo-historico">Histórico de alterações</h2>
        </div>
    </header>
    @if (Model.Any())
    {
        <ol class="timeline">
            @foreach (var item in Model.OrderByDescending(registro => registro.OcorridaEm))
            {
                var criacao = item.Acao == "Added";
                var alteracoes = AuditoriaFormatador.Interpretar(item.Alteracoes, criacao);
                <li class="timeline-item" data-acao="@item.Acao">
                    <span class="timeline-marker" aria-hidden="true"></span>
                    <div class="timeline-body">
                        <div class="timeline-head">
                            <strong>@AuditoriaFormatador.DescreverAcao(item.Acao)</strong>
                            <span class="text-muted">por @item.Usuario</span>
                            <time class="timeline-time" datetime="@item.OcorridaEm.ToString("O")">@item.OcorridaEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time>
                        </div>
                        @if (alteracoes.Count > 0)
                        {
                            var visiveis = alteracoes.Take(6).ToList();
                            var restantes = alteracoes.Skip(6).ToList();
                            <ul class="change-list">
                                @foreach (var alteracao in visiveis)
                                {
                                    <li>
                                        <span class="change-field">@alteracao.Campo</span>
                                        @if (!criacao && alteracao.De is not null)
                                        {
                                            <span class="change-old">@alteracao.De</span>
                                            <span aria-hidden="true">→</span>
                                        }
                                        <span class="change-new">@(alteracao.Para ?? "(vazio)")</span>
                                    </li>
                                }
                            </ul>
                            @if (restantes.Count > 0)
                            {
                                <details class="change-more">
                                    <summary>Mais @restantes.Count alteração(ões)</summary>
                                    <ul class="change-list">
                                        @foreach (var alteracao in restantes)
                                        {
                                            <li>
                                                <span class="change-field">@alteracao.Campo</span>
                                                @if (!criacao && alteracao.De is not null)
                                                {
                                                    <span class="change-old">@alteracao.De</span>
                                                    <span aria-hidden="true">→</span>
                                                }
                                                <span class="change-new">@(alteracao.Para ?? "(vazio)")</span>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                        }
                    </div>
                </li>
            }
        </ol>
    }
    else
    {
        <p class="empty-state mb-0">Nenhuma alteração registrada para este processo.</p>
    }
</section>
