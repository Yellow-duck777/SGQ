@model (string Processo, int Id)
@using SGQ.Web.Models
@{
    var anexos = ViewBag.Anexos as IEnumerable<Anexo> ?? [];
    var podeGerenciar = User.IsInRole("GQ") || User.IsInRole("Administrador");
}
<section class="card shadow-sm border-0 p-4 mt-4">
    <h2 class="h5">Anexos e evidências</h2>
    <form asp-controller="Anexos" asp-action="Enviar" method="post" enctype="multipart/form-data" class="row g-2">
        <input type="hidden" name="processo" value="@Model.Processo" /><input type="hidden" name="id" value="@Model.Id" />
        <div class="col-md-4"><input type="file" name="arquivo" class="form-control" required /></div>
        <div class="col-md-4"><input type="text" name="descricao" class="form-control" placeholder="Descrição opcional" /></div>
        <div class="col-md-2 form-check pt-2"><input type="checkbox" name="critico" value="true" class="form-check-input" id="critico" /><label class="form-check-label" for="critico">Crítico</label></div>
        <div class="col-md-2"><button class="btn btn-outline-primary">Enviar</button></div>
    </form>
    <ul class="list-group list-group-flush mt-3">
    @foreach (var anexo in anexos)
    {
        var processosRelacionados = new[] { anexo.ReclamacaoCliente?.Codigo, anexo.NaoConformidade?.Codigo, anexo.Recall?.Codigo }
            .Concat(anexo.Vinculos.SelectMany(vinculo => new[] { vinculo.ReclamacaoCliente?.Codigo, vinculo.NaoConformidade?.Codigo, vinculo.Recall?.Codigo }))
            .Where(codigo => !string.IsNullOrWhiteSpace(codigo)).Distinct();
        <li class="list-group-item">
            <div class="d-flex justify-content-between gap-3 flex-wrap"><span><strong>@anexo.NomeOriginal</strong> @if(anexo.Critico){<span class="badge text-bg-warning">Crítico</span>} @if(!anexo.Ativo){<span class="badge text-bg-secondary">Anulado</span>}</span><span>@if(anexo.Ativo){<a asp-controller="Anexos" asp-action="Baixar" asp-route-id="@anexo.Id">Baixar</a>}</span></div>
            <small class="d-block text-muted mt-1">Processos relacionados: @string.Join(", ", processosRelacionados)</small>
            @if (anexo.Ativo && podeGerenciar)
            {
                <div class="d-flex gap-2 flex-wrap mt-2">
                    <form asp-controller="Anexos" asp-action="Vincular" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@anexo.Id" /><input type="hidden" name="processo" value="@Model.Processo" /><input type="hidden" name="processoId" value="@Model.Id" /><input name="codigoDestino" class="form-control form-control-sm" required placeholder="Código do processo, ex.: NC-2026-000001" /><button class="btn btn-sm btn-outline-primary">Vincular</button></form>
                    <form asp-controller="Anexos" asp-action="Anular" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@anexo.Id" /><input type="hidden" name="processo" value="@Model.Processo" /><input type="hidden" name="processoId" value="@Model.Id" /><input name="justificativa" class="form-control form-control-sm" required placeholder="Justificativa da anulação" /><button class="btn btn-sm btn-outline-danger">Anular</button></form>
                </div>
            }
        </li>
    }
    </ul>
</section>
