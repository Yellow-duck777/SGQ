@model (string Processo, int Id)
@using SGQ.Web.Models
@{ var anexos = ViewBag.Anexos as IEnumerable<Anexo> ?? []; }
<section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Anexos e evidências</h2><form asp-controller="Anexos" asp-action="Enviar" method="post" enctype="multipart/form-data" class="row g-2"><input type="hidden" name="processo" value="@Model.Processo" /><input type="hidden" name="id" value="@Model.Id" /><div class="col-md-4"><input type="file" name="arquivo" class="form-control" required /></div><div class="col-md-4"><input type="text" name="descricao" class="form-control" placeholder="Descrição opcional" /></div><div class="col-md-2 form-check pt-2"><input type="checkbox" name="critico" value="true" class="form-check-input" id="critico" /><label class="form-check-label" for="critico">Crítico</label></div><div class="col-md-2"><button class="btn btn-outline-primary">Enviar</button></div></form><ul class="list-group list-group-flush mt-3">@foreach (var anexo in anexos) { <li class="list-group-item d-flex justify-content-between"><span>@anexo.NomeOriginal @if(anexo.Critico){<span class="badge text-bg-warning">Crítico</span>} @if(!anexo.Ativo){<span class="badge text-bg-secondary">Anulado</span>}</span><span>@if(anexo.Ativo){<a asp-controller="Anexos" asp-action="Baixar" asp-route-id="@anexo.Id">Baixar</a>} @if(anexo.Ativo && User.IsInRole("GQ")){<form asp-controller="Anexos" asp-action="Anular" method="post" class="d-inline"><input type="hidden" name="id" value="@anexo.Id" /><input type="hidden" name="processo" value="@Model.Processo" /><input type="hidden" name="processoId" value="@Model.Id" /><input name="justificativa" required placeholder="Justificativa" /><button class="btn btn-sm btn-outline-danger">Anular</button></form>}</span></li> }</ul></section>
