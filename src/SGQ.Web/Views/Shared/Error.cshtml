@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<h1 class="text-danger">Erro.</h1>
<h2 class="text-danger">Ocorreu um erro ao processar sua solicitação.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>ID da solicitação:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Modo de desenvolvimento</h3>
<p>
    O ambiente <strong>Development</strong> exibe informações mais detalhadas sobre o erro ocorrido.
</p>
<p>
    <strong>O ambiente Development não deve ser habilitado em aplicações publicadas.</strong>
    Ele pode expor informações sensíveis de exceções aos usuários finais.
    Para depuração local, habilite o ambiente <strong>Development</strong> definindo a variável de ambiente <strong>ASPNETCORE_ENVIRONMENT</strong> como <strong>Development</strong>
    e reinicie a aplicação.
</p>
    ViewData["Title"] = "Algo deu errado";
}

<div class="simple-page">
    <div class="account-state-icon" data-tom="perigo" aria-hidden="true">!</div>
    <p class="eyebrow">Erro inesperado</p>
    <h1 class="h2">Algo deu errado</h1>
    <p>Não foi possível concluir o que você pediu. Tente novamente em instantes.</p>
    <p>Se o problema continuar, avise o responsável pelo sistema e informe o código abaixo.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">Código do atendimento: <code>@Model.RequestId</code></p>
    }
    <p class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Ir para a visão geral</a>
        <a class="btn btn-outline-secondary" href="~/" data-history-back>Voltar</a>
    </p>
</div>
