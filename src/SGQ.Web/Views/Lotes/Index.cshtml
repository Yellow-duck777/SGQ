@model IEnumerable<SGQ.Web.Models.Lote>
@{ ViewData["Title"] = "Lotes"; }
<div class="page-heading d-flex justify-content-between align-items-center gap-3 mb-4"><div><p class="eyebrow mb-1">Cadastros básicos</p><h1>Lotes</h1><p class="text-muted mb-0">Vincule cada lote ao respectivo produto.</p></div><a class="btn btn-primary" asp-action="Create">Novo lote</a></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success" role="alert">@success</div> }
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Número</th><th>Produto</th><th class="text-end">Ações</th></tr></thead><tbody>
@foreach (var lote in Model) { <tr><td>@lote.Numero</td><td>@lote.Produto.Nome</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@lote.Id">Editar</a></td></tr> }
@if (!Model.Any()) { <tr><td colspan="3" class="text-center text-muted py-4">Nenhum lote cadastrado.</td></tr> }
</tbody></table></div></div>
