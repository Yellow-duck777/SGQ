@model SGQ.Domain.Entities.Lote
@{ ViewData["Title"] = "Editar lote"; }
@section Styles { <link rel="stylesheet" href="~/css/modulos/cadastros.css" asp-append-version="true" /> }
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

<header class="page-header">
    <div class="page-header-main">
        <p class="eyebrow mb-1">Cadastros básicos</p>
        <h1>Editar lote</h1>
        <p class="page-header-lead">Os campos marcados com * são obrigatórios. Alterar o produto muda o vínculo em todos os processos que usam este lote.</p>
    </div>
</header>

<form method="post" class="cad-form-narrow" novalidate>
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <section class="form-section">
        <header><h2>Dados do lote</h2><p class="help">O número identifica o lote nas reclamações e recalls.</p></header>
        <div class="form-grid">
            <div class="span-6">
                <label asp-for="Numero" class="form-label required">Número do lote</label>
                <input asp-for="Numero" class="form-control" maxlength="80" autofocus autocomplete="off" />
                <span asp-validation-for="Numero" class="field-error"></span>
            </div>
            <div class="span-6">
                <label asp-for="ProdutoId" class="form-label required">Produto</label>
                <select asp-for="ProdutoId" asp-items="ViewBag.Produtos" class="form-select"></select>
                <span asp-validation-for="ProdutoId" class="field-error"></span>
            </div>
        </div>
    </section>
    <div class="form-actions"><button class="btn btn-primary" type="submit">Salvar</button><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a></div>
</form>
