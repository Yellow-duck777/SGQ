@model SGQ.Domain.Entities.Cliente
@{ ViewData["Title"] = "Editar cliente"; }
@section Styles { <link rel="stylesheet" href="~/css/modulos/cadastros.css" asp-append-version="true" /> }
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

<header class="page-header">
    <div class="page-header-main">
        <p class="eyebrow mb-1">Cadastros básicos</p>
        <h1>Editar cliente</h1>
        <p class="page-header-lead">Os campos marcados com * são obrigatórios.</p>
    </div>
</header>

<form method="post" class="cad-form-narrow" novalidate>
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <section class="form-section">
        <header><h2>Dados do cliente</h2><p class="help">Aparecem na escolha do cliente ao registrar uma reclamação.</p></header>
        <div class="form-grid">
            <div>
                <label asp-for="Nome" class="form-label required">Nome do cliente</label>
                <input asp-for="Nome" class="form-control" maxlength="150" autofocus autocomplete="off" />
                <span asp-validation-for="Nome" class="field-error"></span>
            </div>
            <div>
                <label asp-for="Contato" class="form-label required">Contato</label>
                <input asp-for="Contato" class="form-control" maxlength="150" aria-describedby="ajuda-contato" autocomplete="off" />
                <div id="ajuda-contato" class="form-text">Telefone, e-mail ou nome da pessoa responsável.</div>
                <span asp-validation-for="Contato" class="field-error"></span>
            </div>
        </div>
    </section>
    <div class="form-actions"><button class="btn btn-primary" type="submit">Salvar</button><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a></div>
</form>
