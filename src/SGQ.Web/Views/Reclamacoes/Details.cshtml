@model SGQ.Web.Models.ReclamacaoCliente
@{ ViewData["Title"] = Model.Codigo; }
@if (TempData["Success"] is string success) { <div class="alert alert-success" role="alert">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
<div class="page-heading d-flex justify-content-between align-items-center gap-3 mb-4"><div><p class="eyebrow mb-1">Reclamação de Cliente</p><h1>@Model.Codigo</h1><span class="badge text-bg-secondary">@Model.Status</span></div><a class="btn btn-outline-secondary" asp-action="Index">Voltar</a></div>
<div class="row g-4"><div class="col-lg-8"><div class="card shadow-sm border-0 p-4"><h2 class="h5">Ocorrência</h2><dl class="row mb-0"><dt class="col-sm-4">Cliente</dt><dd class="col-sm-8">@Model.Cliente.Nome</dd><dt class="col-sm-4">Contato</dt><dd class="col-sm-8">@Model.ContatoCliente</dd><dt class="col-sm-4">Produto</dt><dd class="col-sm-8">@Model.Produto.Nome</dd><dt class="col-sm-4">Lotes</dt><dd class="col-sm-8">@(Model.Lotes.Any() ? string.Join(", ", Model.Lotes.Select(item => item.Lote.Numero)) : "Não informado")</dd><dt class="col-sm-4">Descrição</dt><dd class="col-sm-8">@Model.Descricao</dd><dt class="col-sm-4">NC vinculada</dt><dd class="col-sm-8">@(Model.NaoConformidade?.Codigo ?? "Ainda não criada")</dd></dl></div></div><div class="col-lg-4"><div class="card shadow-sm border-0 p-4"><h2 class="h5">Registro</h2><p class="mb-2"><strong>Recebimento:</strong><br />@Model.DataRecebimento.ToString("dd/MM/yyyy")</p><p class="mb-2"><strong>Canal:</strong><br />@Model.CanalRecebimento</p><p class="mb-0"><strong>Criado por:</strong><br />@Model.UsuarioAbertura</p></div></div></div>
@if (Model.Status is SGQ.Web.Models.StatusReclamacao.Rascunho or SGQ.Web.Models.StatusReclamacao.InformacoesPendentes or SGQ.Web.Models.StatusReclamacao.AguardandoValidacaoGq) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Validação da GQ</h2><p class="text-muted">A validação classifica a reclamação e cria automaticamente a NC vinculada.</p><form asp-action="Validar" method="post" class="d-flex flex-wrap gap-2 align-items-end"><input type="hidden" name="id" value="@Model.Id" /><div><label class="form-label" for="classificacao">Classificação</label><select class="form-select" id="classificacao" name="classificacao" asp-items="Html.GetEnumSelectList<SGQ.Web.Models.ClassificacaoOcorrencia>()"></select></div><button class="btn btn-primary" type="submit">Validar e criar NC</button></form></section> }
@if (Model.Status == SGQ.Web.Models.StatusReclamacao.EmInvestigacao) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Conclusão da investigação</h2><form asp-action="Concluir" method="post"><input type="hidden" name="Id" value="@Model.Id" /><div class="row g-3"><div class="col-12"><label class="form-label" for="Investigacao">Investigação</label><textarea class="form-control" name="Investigacao" id="Investigacao" rows="3" required></textarea></div><div class="col-md-4"><label class="form-label" for="Resultado">Resultado</label><select class="form-select" name="Resultado" id="Resultado" asp-items="Html.GetEnumSelectList<SGQ.Web.Models.ResultadoReclamacao>()"></select></div><div class="col-md-8"><label class="form-label" for="TratamentoAplicado">Tratamento aplicado</label><input class="form-control" name="TratamentoAplicado" id="TratamentoAplicado" required /></div><div class="col-md-4"><label class="form-label" for="DataRespostaCliente">Data da resposta</label><input class="form-control" type="date" name="DataRespostaCliente" id="DataRespostaCliente" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div><div class="col-md-8"><label class="form-label" for="RespostaCliente">Resposta ao cliente</label><input class="form-control" name="RespostaCliente" id="RespostaCliente" required /></div></div><button class="btn btn-primary mt-3" type="submit">Registrar conclusão</button></form></section> }
@if (Model.Status == SGQ.Web.Models.StatusReclamacao.AguardandoConclusao) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Encerramento pela GQ</h2><p><strong>Resultado:</strong> @Model.Resultado<br /><strong>Tratamento:</strong> @Model.TratamentoAplicado<br /><strong>Resposta ao cliente:</strong> @Model.RespostaCliente</p><form asp-action="Encerrar" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-primary" type="submit">Encerrar reclamação</button></form></section> }
@if (Model.Status == SGQ.Web.Models.StatusReclamacao.Encerrada) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Reabertura</h2><p class="text-muted">A reabertura retorna a reclamação para investigação e mantém a NC vinculada.</p><form asp-action="Reabrir" method="post"><input type="hidden" name="Id" value="@Model.Id" /><label class="form-label" for="Justificativa">Justificativa</label><textarea class="form-control" id="Justificativa" name="Justificativa" rows="3" minlength="10" maxlength="2000" required></textarea><button class="btn btn-outline-danger mt-3" type="submit">Reabrir reclamação</button></form></section> }
@if (Model.ReabertaEm.HasValue) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Última reabertura</h2><p class="mb-1">@Model.JustificativaReabertura</p><p class="mb-0 text-muted">Por @Model.UsuarioReabertura em @Model.ReabertaEm.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm"). Status anterior: @Model.StatusAnteriorReabertura.</p></section> }
@if (Model.Status == SGQ.Web.Models.StatusReclamacao.EmInvestigacao) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Laboratório externo</h2><form asp-action="SolicitarLaboratorio" method="post" class="row g-2"><input type="hidden" name="Id" value="@Model.Id" /><div class="col-md-6"><input name="Laboratorio" class="form-control" placeholder="Laboratório responsável" required /></div><div class="col-md-4"><input name="DataEnvioAmostra" type="date" class="form-control" required /></div><div class="col-md-2"><button class="btn btn-outline-primary">Solicitar</button></div></form></section> }
@if (Model.Status == SGQ.Web.Models.StatusReclamacao.AguardandoLaboratorioExterno) { <section class="card shadow-sm border-0 p-4 mt-4"><h2 class="h5">Resultado do laboratório</h2><p>Envie o laudo como anexo crítico e depois registre o resultado.</p><form asp-action="RegistrarResultadoLaboratorio" method="post" class="row g-2"><input type="hidden" name="Id" value="@Model.Id" /><div class="col-md-3"><input name="DataRecebimento" type="date" class="form-control" required /></div><div class="col-md-4"><input name="IdentificacaoLaudo" class="form-control" placeholder="Identificação do laudo" required /></div><div class="col-md-5"><input name="Resultado" class="form-control" placeholder="Resultado" required /></div><div class="col-12"><button class="btn btn-primary">Registrar resultado</button></div></form></section> }
<partial name="_Anexos" model='("Reclamacoes", Model.Id)' />
