@model SGQ.Web.Models.ReclamacaoCliente
@{ ViewData["Title"] = Model.Codigo; }
@if (TempData["Success"] is string success) { <div class="alert alert-success" role="alert">@success</div> }
<div class="page-heading d-flex justify-content-between align-items-center gap-3 mb-4"><div><p class="eyebrow mb-1">Reclamação de Cliente</p><h1>@Model.Codigo</h1><span class="badge text-bg-secondary">@Model.Status</span></div><a class="btn btn-outline-secondary" asp-action="Index">Voltar</a></div>
<div class="row g-4"><div class="col-lg-8"><div class="card shadow-sm border-0 p-4"><h2 class="h5">Ocorrência</h2><dl class="row mb-0"><dt class="col-sm-4">Cliente</dt><dd class="col-sm-8">@Model.Cliente.Nome</dd><dt class="col-sm-4">Contato</dt><dd class="col-sm-8">@Model.ContatoCliente</dd><dt class="col-sm-4">Produto</dt><dd class="col-sm-8">@Model.Produto.Nome</dd><dt class="col-sm-4">Lotes</dt><dd class="col-sm-8">@(Model.Lotes.Any() ? string.Join(", ", Model.Lotes.Select(item => item.Lote.Numero)) : "Não informado")</dd><dt class="col-sm-4">Descrição</dt><dd class="col-sm-8">@Model.Descricao</dd></dl></div></div><div class="col-lg-4"><div class="card shadow-sm border-0 p-4"><h2 class="h5">Registro</h2><p class="mb-2"><strong>Recebimento:</strong><br />@Model.DataRecebimento.ToString("dd/MM/yyyy")</p><p class="mb-2"><strong>Canal:</strong><br />@Model.CanalRecebimento</p><p class="mb-0"><strong>Criado por:</strong><br />@Model.UsuarioAbertura</p></div></div></div>
