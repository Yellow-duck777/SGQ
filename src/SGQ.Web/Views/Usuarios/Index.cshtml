@model IEnumerable<SGQ.Web.ViewModels.UsuarioPerfilViewModel>
@using SGQ.Web.Security
@{ ViewData["Title"] = "Usuários e perfis"; }
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<div class="page-heading mb-4"><p class="eyebrow mb-1">Administração</p><h1>Usuários e perfis</h1><p class="text-muted mb-0">Atribua as responsabilidades que controlam os processos do SGQ.</p></div>
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Usuário</th><th>Perfis atuais</th><th>Atualizar perfis</th></tr></thead><tbody>@foreach (var user in Model) { <tr><td><strong>@user.Email</strong><br /><small class="text-muted">@user.NomeUsuario</small></td><td>@(user.Perfis.Any() ? string.Join(", ", user.Perfis) : "Sem perfil")</td><td><form asp-action="AtualizarPerfis" method="post"><input type="hidden" name="id" value="@user.Id" /><div class="d-flex flex-wrap gap-2">@foreach (var perfil in Roles.Todos) { <div class="form-check"><input class="form-check-input" type="checkbox" name="perfis" value="@perfil" id="@($"{user.Id}-{perfil}")" checked="@user.Perfis.Contains(perfil)" /><label class="form-check-label" for="@($"{user.Id}-{perfil}")">@perfil</label></div> }<button class="btn btn-sm btn-primary">Salvar</button></div></form></td></tr> }@if (!Model.Any()) { <tr><td colspan="3" class="text-center text-muted py-4">Nenhum usuário cadastrado.</td></tr> }</tbody></table></div></div>
